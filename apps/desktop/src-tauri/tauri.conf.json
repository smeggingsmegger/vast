{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vast",
  "version": "0.1.0",
  "identifier": "app.vast.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @vast/web dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --filter @vast/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vast",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
