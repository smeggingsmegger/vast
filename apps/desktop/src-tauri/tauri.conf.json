{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vast",
  "version": "0.1.0",
  "identifier": "app.vast.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @vast/web dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "node -e \"const{existsSync}=require('fs');const p=require('path');const a=p.join('src-tauri','resources','sidecar','server','dist','index.js');const b=p.join('resources','sidecar','server','dist','index.js');if(!existsSync(a)&&!existsSync(b)){console.error('Sidecar missing. Run: pnpm desktop:sidecar');process.exit(1)}console.log('sidecar present')\"",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vast",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 500,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "MongoDB workbench",
    "longDescription": "Vast — professional MongoDB workbench for browse, query, and edit.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/sidecar/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  }
}
